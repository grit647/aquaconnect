# Google service account ผูกกับ Google Sheet "aquaconnect-th"
# สร้างแยกเฉพาะโปรเจกต์นี้ (ไม่ใช้ร่วมกับโปรเจกต์อื่น) — ดูขั้นตอนใน CLAUDE.md
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCDeFGhijKLmnoPQRstuVWxyz

# เลขพอร์ตที่เซิร์ฟเวอร์รัน (Render จะกำหนด PORT เองอัตโนมัติ ไม่ต้องตั้งบน Render)
PORT=8787

# สตริงลับสำหรับเซ็น session token — ตั้งเป็นค่าสุ่มยาวๆ ไม่ซ้ำกับโปรเจกต์อื่น
JWT_SECRET=change-this-to-a-long-random-string

# Cloudinary — ใช้เก็บรูปภาพประกาศขายลูกกุ้ง (ถาวร ไม่หายตอน Render deploy ใหม่
# ต่างจากการเขียนไฟล์ลง disk เซิร์ฟเวอร์เอง) สมัครฟรีที่ cloudinary.com แล้วดู
# ค่า 3 ตัวนี้ได้จากหน้า Dashboard หลัง login — สร้างบัญชีแยกเฉพาะโปรเจกต์นี้
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ฐานข้อมูล Postgres (Supabase โปรเจกต์ aquaconnect) — ใช้ Session pooler
# แยกเป็นช่อง เพื่อให้รหัสผ่านมีอักขระพิเศษได้ (@ # / ? ฯลฯ) โดยไม่ต้องแปลงรหัส
# ถ้ารหัสผ่านมีอักขระพิเศษ ให้ครอบด้วยเครื่องหมายคำพูดคู่ "..." เสมอ
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_NAME=postgres
DB_PASSWORD="your-database-password"

# ใช้ครั้งเดียวตอนรัน "npm run seed:admin" เพื่อสร้างบัญชีแอดมินคนแรก
# (ลบ 2 บรรทัดนี้ทิ้งได้หลังรันเสร็จ ไม่จำเป็นต้องมีตอนรันเซิร์ฟเวอร์ปกติ
# และห้าม commit ค่าจริงของ 2 ค่านี้ลง git — ไฟล์ .env ทั้งไฟล์ถูกกันไว้ใน
# .gitignore อยู่แล้ว)
SEED_ADMIN_PHONE=08XXXXXXXX
SEED_ADMIN_PIN=123456

# Gemini (Vertex AI) — สมองของ AI เลขา ใช้ Service Account ชุดเดียวกับที่ครีม (ช.นายท้าย) ใช้อยู่
# (ค่าใช้จ่ายและโควตารวมกับโปรเจกต์ Google Cloud นั้น) ไม่บังคับ: VERTEX_LOCATION (ค่าเริ่มต้น us-central1), VERTEX_MODEL (ค่าเริ่มต้น gemini-2.5-flash)
VERTEX_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
VERTEX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# LINE OA (ช่อง Messaging API) — ดูค่าได้ที่ LINE Developers Console > ช่องของ OA > แท็บ Basic settings / Messaging API
LINE_CHANNEL_SECRET=your-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token

# LINE Login (ช่องที่สร้าง LIFF ไว้ ต้องอยู่ Provider เดียวกับ OA) — ใช้ให้หน้าเว็บในไลน์รู้ว่าใครเปิดอยู่
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LIFF_ID=your-liff-id
